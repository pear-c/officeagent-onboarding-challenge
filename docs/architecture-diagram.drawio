          <mxGeometry x="490" y="240" width="80" height="50" as="geometry"/>
        </mxCell>

        <!-- Stage 2: Similar question -->
        <mxCell id="c-s2" value="2단계: 유사 질문 캐시&#xa;embed(질문) → Chroma cache collection&#xa;cosine similarity ≥ 0.95" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="330" width="300" height="55" as="geometry"/>
        </mxCell>

        <!-- Stage 2 decision -->
        <mxCell id="c-d2" value="hit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="420" width="80" height="50" as="geometry"/>
        </mxCell>

        <!-- RAG Pipeline -->
        <mxCell id="c-rag" value="RAG 파이프라인 실행&#xa;(임베딩 → 벡터 검색 → LLM 호출)&#xa;⏱ 3~15초" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="510" width="280" height="55" as="geometry"/>
        </mxCell>

        <!-- Cache save -->
        <mxCell id="c-save" value="캐시 저장&#xa;• Redis: SHA-256(질문) → 답변&#xa;• Chroma: embed(질문) → cache collection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="600" width="300" height="55" as="geometry"/>
        </mxCell>

        <!-- Response (cached) -->
