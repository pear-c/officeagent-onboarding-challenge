        <!-- Stage 1: Exact match -->
        <mxCell id="c-s1" value="1단계: 정확 일치 캐시&#xa;SHA-256(질문) → Redis 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
