# 모든 텍스트 파일은 LF 줄바꿈 강제 (Windows ↔ Mac 멀티 머신 작업)
* text=auto eol=lf

# 셸 스크립트는 무조건 LF (CRLF면 실행 불가)
*.sh   text eol=lf
*.bash text eol=lf

# Windows 전용 스크립트만 CRLF 허용
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 바이너리 파일 명시 (변환 방지)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.ico  binary
