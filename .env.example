# 서버
APP_HOST=0.0.0.0
APP_PORT=8000

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_COLLECTION=documents
CHROMA_CACHE_COLLECTION=cache_questions

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=3600

# 임베딩
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# 청킹
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# LLM
LLM_ANSWER_PROVIDER=claude
LLM_AUXILIARY_PROVIDER=codex
LLM_MAX_TOKENS=1024

# 검색
SEARCH_TOP_K=5
CACHE_SIMILARITY_THRESHOLD=0.95
